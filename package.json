    "express": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.12"
  },
  "description": "Video learning in short chapters with quizzes and persistent progress",
